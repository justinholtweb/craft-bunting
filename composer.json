{
    "name": "justinholtweb/craft-bunting",
    "description": "Feature flags for Craft on Laravel Pennant — flip them in the CP, scope them to users, groups, sites or a percentage.",
    "type": "craft-plugin",
    "version": "6.0.0-beta.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "bunting",
        "laravel"
    ],
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-beta.1",
        "laravel/pennant": "^1.18"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "JustinHoltWeb\\Bunting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustinHoltWeb\\Bunting\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check-cs": "pint --test",
        "fix-cs": "pint"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/justinholtweb/craft-bunting/issues",
        "source": "https://github.com/justinholtweb/craft-bunting"
    },
    "extra": {
        "name": "Bunting",
        "handle": "bunting",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-bunting",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-bunting/main/CHANGELOG.md",
        "class": "JustinHoltWeb\\Bunting\\Plugin"
    }
}
